# DataScraper — copy to .env and fill in what you use

# Provider: ollama | claude
AI_PROVIDER=ollama

# Ollama (local — default http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Scraper defaults
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (compatible; DataScraper/1.0; internal)
MAX_PAGES_DEFAULT=5
OUTPUT_DIR=output
PLANS_DIR=plans
