# DataScraper — copy to .env and fill in what you use

# Provider: gemini | groq | claude | ollama
# Gemini (free, fast) is the recommended default. Ollama works but is impractically slow
# on CPU-only machines for anything beyond a trivial plan — see README.
AI_PROVIDER=gemini

# Ollama (local — default http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Google Gemini — free API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq — free API key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Claude (Anthropic) — paid API credits
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Scraper defaults
REQUEST_TIMEOUT=30
USER_AGENT=Mozilla/5.0 (compatible; DataScraper/1.0; internal)
MAX_PAGES_DEFAULT=500
# 0 = enrich every row missing model_year (slower). Set e.g. 200 to cap detail fetches.
ENRICH_DETAIL_LIMIT=0
OUTPUT_DIR=output
PLANS_DIR=plans
