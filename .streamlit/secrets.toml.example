# Streamlit Cloud → Manage app → Settings → Secrets
# Paste ONLY keys below. Do NOT put GEMINI_MODEL / GROQ_MODEL here —
# model IDs live in app/config.py and are ignored from Secrets on purpose.

AI_PROVIDER = "gemini"
GEMINI_API_KEY = "your-gemini-key-here"

# Optional alternative free provider: https://console.groq.com/keys
# AI_PROVIDER = "groq"
# GROQ_API_KEY = "gsk_..."

MAX_PAGES_DEFAULT = "500"
ENRICH_DETAIL_LIMIT = "0"
